# Optional. Without a key the app still works: education is shown as cited verbatim excerpts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: raises NCBI/openFDA rate limits
NCBI_API_KEY=
OPENFDA_API_KEY=
PORT=8787
# Future Epic on FHIR (SMART) client id, not wired yet
VITE_EPIC_CLIENT_ID=
# Optional: lets the scanner use Google Gemini to read the label photo (much more accurate than on-device reading).
# Get a key at https://aistudio.google.com/apikey . Leave blank to keep reading on the device only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
